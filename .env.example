# Railway backend (production API base used by Vite at build time)
VITE_API_URL=https://chirograph-verify-production.up.railway.app

# Clerk (public, not a secret). Replace with your Clerk publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuY2hpcm9ncmFwaHZlcmlmeS5jb20k

# PostHog (public project API key, not a secret). Leave unset to disable analytics.
VITE_POSTHOG_KEY=your_project_api_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
